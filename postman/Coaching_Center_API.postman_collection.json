    {
      "name": "Student Approval Workflow (Admin Only)",
      "item": [
        {
          "name": "Get Pending Students (QueryBuilder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.length > 0) {",
                  "        pm.environment.set(\"pendingStudentId\", json.data[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/pending-students?page=1&limit=10&search=&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "pending-students"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                { "key": "limit", "value": "10", "description": "Items per page" },
                { "key": "search", "value": "", "description": "Partial search on name, email, phone, guardian info" },
                { "key": "sortBy", "value": "createdAt", "description": "Sort field" },
                { "key": "sortOrder", "value": "desc", "description": "asc or desc" }
              ]
            },
            "description": "Protected: Administrator retrieves paginated list of students awaiting activation using universal QueryBuilder."
          }
        },
        {
          "name": "Approve Student Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/pending-students/{{pendingStudentId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "pending-students", "{{pendingStudentId}}", "approve"]
            },
            "description": "Protected: Administrator approves student application and transitions user status from PENDING_ACTIVATION to ACTIVE."
          }
        },
        {
          "name": "Reject Student Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/pending-students/{{pendingStudentId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "pending-students", "{{pendingStudentId}}", "reject"]
            },
            "description": "Protected: Administrator rejects student application and marks account as INACTIVE with soft deletion."
          }
        }
      ]
    },

NODE_ENV="development"
PORT="5000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coaching_management_db?schema=public"
CORS_ORIGIN="http://localhost:3000"

# Authentication & JWT
JWT_ACCESS_SECRET="super_secret_jwt_access_key_min_32_characters_long_for_security"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_min_32_characters_long_for_security"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS="12"

# Google OAuth (Social Auth for Students)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="placeholder_cloud_name"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"

# Initial Seed Credentials (Super Admin & Default Branch Admin)
SUPER_ADMIN_NAME="Example Super Admin"
SUPER_ADMIN_EMAIL="example.super.admin@coaching.com"
SUPER_ADMIN_PASSWORD="*************"
SUPER_ADMIN_PHONE="+8801300000000"

ADMIN_NAME="Example Branch Admin"
ADMIN_EMAIL="example.admin@gmail.com"
ADMIN_PASSWORD="***************"
ADMIN_PHONE="+8801700000001"
ADMIN_BRANCH_NAME="Example Campus"
ADMIN_BRANCH_ADDRESS="House 12, Road 5, Dhanmondi, Dhaka"
ADMIN_BRANCH_PHONE="+8801700000002"

model Batch {
  id        String      @id @default(uuid())
  adminId   String // The Branch Admin who created/owns this class batch
  name      String // e.g. "Class 8", "Class 9 - Morning", "Class 10"
  fee       Decimal     @db.Decimal(10, 2)
  status    BatchStatus @default(ONGOING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime? // Universal soft delete

  // Relations
  admin             User               @relation("AdminBatches", fields: [adminId], references: [id])
  routines          ClassRoutine[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  exams             Exam[]
  payments          PaymentTransaction[]

  @@index([adminId])
  @@index([status])
  @@index([deletedAt])
  @@map("batches")
}

# ==============================================================================
# Docker Environment Configuration Template
# Copy this file to .env or reference it when deploying via Docker Compose
# ==============================================================================

NODE_ENV="production"
PORT="5000"

# Note: Within Docker Compose network, use service hostnames 'postgres' and 'redis'
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/coaching_management_db?schema=public"
REDIS_URL="redis://redis:6379"

# Automatic Migration Runner on Startup (true/false)
RUN_MIGRATIONS="true"

# CORS configuration
CORS_ORIGIN="http://localhost:3000"

# Authentication & JWT Secrets (Min 32 characters each)
JWT_ACCESS_SECRET="super_secret_jwt_access_key_min_32_characters_long_for_security"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_min_32_characters_long_for_security"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS="12"

# Google OAuth (Student Social Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="placeholder_cloud_name"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"

# Email & SMTP Service (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Coaching Center <noreply@coaching.com>"
FRONTEND_URL="http://localhost:3000"

# Initial Root Administrator & Institution Profile (Automated Startup Seeding)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@coaching.com"
ADMIN_PASSWORD="your_secure_admin_password_here"
ADMIN_PHONE="+8801700000001"
ADMIN_INSTITUTION_NAME="Coaching Center Academy"
ADMIN_INSTITUTION_ADDRESS="Dhanmondi, Dhaka"
ADMIN_INSTITUTION_PHONE="+8801700000001"
ADMIN_INSTITUTION_EMAIL="admin@coaching.com"

# Postgres & Redis container configuration (for docker-compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="coaching_management_db"
POSTGRES_PORT="5432"
REDIS_PORT="6379"
